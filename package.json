{
  "name": "receitoteca-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "tsc && node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:load": "npm run db:migrate && npm run db:seed",
    "db:drop": "npx prisma migrate reset --force",
    "db:reload": "npm run db:drop && npm run db:seed",
    "db:studio": "npx prisma studio",
    "setup": "npm install && npm run db:generate && npm run db:migrate && npm run db:seed",
    "prepush": "git clean -fd && git rm -r --cached dist/ 2>/dev/null || true"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.2",
    "prisma": "^7.8.0",
    "prisma-erd-generator": "^2.4.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
