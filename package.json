{
  "name": "receitoteca-api",
  "version": "1.0.0",
  "type": "module",
  
 "scripts": {
  "start": "tsx src/index.ts",
  "dev": "tsx watch src/index.ts",
  "dev:all": "npm run db:fresh && npm run dev",

  "db:fresh": "npm run db:drop && npm run db:migrate && npm run db:seed",
  "db:drop": "rm -f prisma/dev.db",
  "db:migrate": "prisma migrate dev --name init",
  "db:seed": "tsx src/database/load.ts",

  "build": "tsc",
  "prisma:generate": "prisma generate",
  "prisma:studio": "prisma studio"
},
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "sqlite-async": "^1.2.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.3",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
