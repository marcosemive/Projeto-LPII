generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

model Usuario {
  id    Int    @id @default(autoincrement())
  nome  String
  email String @unique
  senha String
  role  String @default("ENTUSIASTA")

  receitas  Receita[]
  favoritos Favorito[]
}

model Receita {
  id          Int    @id @default(autoincrement())
  img         String
  title       String
  time        Int
  servings    Int
  ingredients String
  steps       String

  usuario_id Int
  usuario    Usuario @relation(fields: [usuario_id], references: [id])

  etiquetas ReceitaEtiqueta[]
  favoritos Favorito[]
}

model Etiqueta {
  id   Int    @id @default(autoincrement())
  nome String @unique

  receitas ReceitaEtiqueta[]
}

model ReceitaEtiqueta {
  receita_id  Int
  etiqueta_id Int

  receita  Receita  @relation(fields: [receita_id], references: [id], onDelete: Cascade)
  etiqueta Etiqueta @relation(fields: [etiqueta_id], references: [id], onDelete: Cascade)

  @@id([receita_id, etiqueta_id])
}

model Favorito {
  usuario_id Int
  receita_id Int

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  receita Receita @relation(fields: [receita_id], references: [id], onDelete: Cascade)

  @@id([usuario_id, receita_id])
}